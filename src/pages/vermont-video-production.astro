---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SiteHeader } from '../components/SiteHeader';
---

<BaseLayout
  title="Vermont Video Production Company | Corey Hendrickson Productions"
  description="Vermont video production based in Middlebury, VT. Brand films, documentary, corporate video, and television — serving New England and beyond."
>
  <SiteHeader client:load />
  <main class="pt-24 pb-20">

    <div class="mx-auto max-w-4xl px-6 md:px-10">

      <!-- Hero -->
      <h1 class="mb-6 text-3xl font-medium tracking-tight text-foreground md:text-4xl lg:text-5xl text-balance">
        Vermont Video Production
      </h1>
      <p class="mb-16 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
        Corey Hendrickson Productions is a Vermont-based film production company rooted in the belief that authentic storytelling changes how people feel about a place or brand. We make films for brands, nonprofits, and broadcasters who understand that the most powerful stories aren't just well-made, they're honest about the place, the people, and the why behind them.
      </p>

      <!-- What We Make -->
      <div class="mb-16">
        <h2 class="mb-6 text-xs font-medium uppercase tracking-widest text-foreground">
          What We Make
        </h2>
        <p class="mb-4 max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
          We specialize in brand films, documentary content, corporate video, and television production. Every project starts with the same question: why does this story matter? From there we build through discovery, pre-production, and shoot days that stay flexible enough to capture what you can't plan for.
        </p>
        <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
          Our work has aired on PBS, NBC, and HBO. We've made films for Middlebury College, Hotel Vermont, Woodstock Inn &amp; Resort, Vermont Land Trust, Yankee Publishing, and dozens of other Vermont organizations and national brands.
        </p>
      </div>

      <!-- Rooted in Vermont -->
      <div class="mb-16">
        <h2 class="mb-6 text-xs font-medium uppercase tracking-widest text-foreground">
          Rooted in Vermont. Built for New England.
        </h2>
        <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground md:text-base">
          We're based in Middlebury and work regularly across Vermont, including Burlington, Montpelier, Stowe, Woodstock, Brattleboro, and the Northeast Kingdom, as well as throughout New Hampshire, Maine, Massachusetts, and beyond. Being based in Vermont isn't just a location detail. It shapes how we work: unhurried, intentional, and attuned to the kind of quiet authenticity that makes New England stories worth telling.
        </p>
      </div>

      <!-- Services -->
      <div class="mb-16">
        <h2 class="mb-6 text-xs font-medium uppercase tracking-widest text-foreground">
          Services
        </h2>
        <div class="grid gap-3 sm:grid-cols-2 max-w-2xl">
          {[
            "Brand films and commercial video",
            "Documentary production",
            "Corporate and nonprofit video",
            "Television production and crew",
            "Interview and b-roll production",
            "Event and editorial video",
            "Commercial and portrait photography",
          ].map((service) => (
            <div class="flex items-start gap-3">
              <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-foreground"></span>
              <p class="text-sm text-muted-foreground">{service}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- CTA -->
    <div class="border-t border-border mt-8 py-16 text-center">
      <h2 class="mb-4 text-xs font-medium uppercase tracking-widest text-foreground">
        Start a Project
      </h2>
      <p class="mb-6 text-sm text-muted-foreground max-w-md mx-auto leading-relaxed">
        If you're looking for a Vermont video production company that leads with story and delivers with craft, let's talk.
      </p>
      <a
        href="/contact"
        class="text-sm text-foreground underline underline-offset-4 transition-opacity hover:opacity-60"
      >
        Get in touch &rarr;
      </a>
    </div>

  </main>
  <SiteFooter />
</BaseLayout>

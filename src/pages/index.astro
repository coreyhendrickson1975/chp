---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SiteHeader } from '../components/SiteHeader';
import { PortfolioGrid } from '../components/PortfolioGrid';
import { NewsletterSection } from '../components/NewsletterSection';
---

<BaseLayout title="Vermont Video Production | Corey Hendrickson" description="Vermont video production for brand films, documentary, and television. Based in Middlebury, VT — serving New England and beyond.">
  <SiteHeader client:load />
  <main>
    <HeroSection />
    <PortfolioGrid client:load />
    <NewsletterSection client:visible />
  </main>
  <SiteFooter />
</BaseLayout>
